            "https://www.paypal.com/*",
            "https://paypal.com/*",
            "https://www.apple.com/*",
            "https://apple.com/*"
          ]
        },
        {
          "css": [
            "webmodding/sites-05-media.css"
          ],
          "matches": [
            "https://www.netflix.com/*",
            "https://netflix.com/*",
            "https://open.spotify.com/*",
            "https://www.spotify.com/*",
            "https://spotify.com/*",
            "https://www.twitch.tv/*",
            "https://twitch.tv/*",
            "https://www.bbc.com/*",
            "https://bbc.com/*",
            "https://www.bbc.co.uk/*",
            "https://bbc.co.uk/*",
            "https://www.cnn.com/*",
            "https://cnn.com/*",
            "https://www.imdb.com/*",
            "https://imdb.com/*",
            "https://medium.com/*",
            "https://www.medium.com/*"
          ]
        },
        {
          "css": [
            "webmodding/sites-06-productivity.css"
          ],
          "matches": [
            "https://*.wikipedia.org/*",
            "https://www.notion.so/*",
            "https://notion.so/*",
            "https://*.notion.site/*",
            "https://www.dropbox.com/*",
            "https://dropbox.com/*",
            "https://outlook.live.com/*",
            "https://www.office.com/*",
            "https://office.com/*",
            "https://www.microsoft.com/*",
            "https://microsoft.com/*",
            "https://login.live.com/*",
            "https://account.microsoft.com/*",
            "https://www.yahoo.com/*",
            "https://yahoo.com/*",
            "https://mail.yahoo.com/*",
            "https://news.yahoo.com/*",
            "https://store.steampowered.com/*",
            "https://steamcommunity.com/*",
            "https://help.steampowered.com/*",
            "https://*.craigslist.org/*",
            "https://www.indeed.com/*",
            "https://indeed.com/*"
          ]
        },
        {
          "css": [
            "webmodding/bakugo-opera.css"
          ],
          "matches": [
            "https://*.opera.com/*"
          ]
        },
        {
          "css": [
            "webmodding/bakugo-gx-surfaces.css"
          ],
          "matches": [
            "https://*.gx.games/*",
            "https://gx.games/*",
            "https://create.gx.games/*",
            "https://*.gx.me/*",
            "https://gx.me/*",
            "https://store.gx.me/*"
          ]
        }
      ]
    }
  }
}
