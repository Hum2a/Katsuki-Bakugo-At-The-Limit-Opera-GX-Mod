{
  "manifest_version": 3,
  "name": "Katsuki Bakugo - At The Limit",
  "description": "Katsuki Bakugo themed Opera GX mod \u2014 animated wallpaper, custom background music, sounds, red-orange and black hero colours, shaders, and webmodding for 21+ popular sites (YouTube, X, Reddit, Discord, GitHub, Netflix, Spotify, and more)",
  "version": "1.1.0",
  "icons": {
    "512": "Bakugo_AtLimit_Icon.png"
  },
  "developer": {
    "name": "Humza Butt"
  },
  "mod": {
    "schema_version": 1,
    "license": "license.txt",
    "payload": {
      "wallpaper": {
        "dark": {
          "image": "wallpaper/Bakugo_At_The_Limit.mp4",
          "first_frame": "wallpaper/Bakugo_At_The_Limit.first_frame.png",
          "text_color": "#E63E18",
          "text_shadow": "#000000"
        },
        "light": {
          "image": "wallpaper/Bakugo_At_The_Limit.mp4",
          "first_frame": "wallpaper/Bakugo_At_The_Limit.first_frame.png",
          "text_color": "#141414",
          "text_shadow": "#FF7845"
        }
      },
      "background_music": [
        "music/At_The_Limit.mp3"
      ],
      "browser_sounds": {
        "CLICK": [
          "sound/click.wav"
        ],
        "FEATURE_SWITCH_OFF": [
          "sound/feature_switch_off.wav"
        ],
        "FEATURE_SWITCH_ON": [
          "sound/feature_switch_on.wav"
        ],
        "HOVER": [
          "sound/hover.wav"
        ],
        "HOVER_UP": [
          "sound/hover.wav"
        ],
        "IMPORTANT_CLICK": [
          "sound/important_click.wav"
        ],
        "LEVEL_UPGRADE": [
          "sound/level_upgrade.wav"
        ],
        "LIMITER_OFF": [
          "sound/limiter_off.wav"
        ],
        "LIMITER_ON": [
          "sound/limiter_on.wav"
        ],
        "SWITCH_TOGGLE": [
          "sound/switch.wav"
        ],
        "TAB_CLOSE": [
          "sound/close_tab.wav"
        ],
        "TAB_INSERT": [
          "sound/new_tab.wav"
        ],
        "TAB_SLASH": [
          "sound/tab_slash.wav"
        ]
      },
      "keyboard_sounds": {
        "TYPING_BACKSPACE": [
          "keyboard/backspace.wav"
        ],
        "TYPING_ENTER": [
          "keyboard/enter.wav"
        ],
        "TYPING_LETTER": [
          "keyboard/letter_1.wav",
          "keyboard/letter_2.wav",
          "keyboard/letter_3.wav"
        ],
        "TYPING_SPACE": [
          "keyboard/space.wav"
        ]
      },
      "theme": {
        "dark": {
          "gx_accent": {
            "h": 15,
            "s": 100,
            "l": 52
          },
          "gx_secondary_base": {
            "h": 15,
            "s": 86,
            "l": 15
          }
        },
        "light": {
          "gx_accent": {
            "h": 15,
            "s": 100,
            "l": 46
          },
          "gx_secondary_base": {
            "h": 15,
            "s": 52,
            "l": 28
          }
        }
      },
      "shaders": {
        "Explosion Glow": {
          "path": "shader/hero_glow.txt"
        },
        "Howitzer Impact": {
          "animation": {
            "duration": 60,
            "steps": 3600
          },
          "path": "shader/plus_ultra.txt"
        }
      },
      "page_styles": [
        {
          "css": [
            "webmodding/bakugo-limit.css"
          ],
          "matches": [
            "https://*/*",
            "http://*/*"
          ]
        },
        {
          "css": [
            "webmodding/sites-01-google-youtube.css"
          ],
          "matches": [
            "https://www.google.com/*",
            "https://google.com/*",
            "https://mail.google.com/*",
            "https://drive.google.com/*",
            "https://docs.google.com/*",
            "https://calendar.google.com/*",
            "https://maps.google.com/*",
            "https://news.google.com/*",
            "https://play.google.com/*",
            "https://accounts.google.com/*",
            "https://photos.google.com/*",
            "https://meet.google.com/*",
            "https://classroom.google.com/*",
            "https://keep.google.com/*",
            "https://translate.google.com/*",
            "https://contacts.google.com/*",
            "https://www.youtube.com/*",
            "https://youtube.com/*",
            "https://m.youtube.com/*",
            "https://music.youtube.com/*"
          ]
        },
        {
          "css": [
            "webmodding/sites-02-social.css"
          ],
          "matches": [
            "https://www.reddit.com/*",
            "https://reddit.com/*",
            "https://old.reddit.com/*",
            "https://new.reddit.com/*",
            "https://www.x.com/*",
            "https://x.com/*",
            "https://twitter.com/*",
            "https://www.twitter.com/*",
            "https://mobile.twitter.com/*",
            "https://www.facebook.com/*",
            "https://facebook.com/*",
            "https://m.facebook.com/*",
            "https://web.facebook.com/*",
            "https://www.instagram.com/*",
            "https://instagram.com/*",
            "https://www.tiktok.com/*",
            "https://tiktok.com/*",
            "https://www.discord.com/*",
            "https://discord.com/*",
            "https://www.pinterest.com/*",
            "https://pinterest.com/*",
            "https://www.tumblr.com/*",
            "https://tumblr.com/*",
            "https://www.linkedin.com/*",
            "https://linkedin.com/*",
            "https://www.threads.net/*",
            "https://threads.net/*",
            "https://web.whatsapp.com/*",
            "https://*.fb.com/*",
            "https://*.messenger.com/*"
          ]
        },
        {
          "css": [
            "webmodding/sites-03-dev.css"
          ],
          "matches": [
            "https://github.com/*",
            "https://gist.github.com/*",
            "https://gitlab.com/*",
            "https://stackoverflow.com/*",
            "https://*.stackexchange.com/*",
            "https://stackexchange.com/*",
            "https://superuser.com/*",
            "https://serverfault.com/*",
            "https://askubuntu.com/*",
            "https://math.stackexchange.com/*",
            "https://news.ycombinator.com/*"
          ]
        },
        {
          "css": [
            "webmodding/sites-04-shopping.css"
          ],
          "matches": [
            "https://www.amazon.com/*",
            "https://amazon.com/*",
            "https://www.amazon.co.uk/*",
            "https://amazon.co.uk/*",
            "https://www.amazon.de/*",
            "https://amazon.de/*",
            "https://www.amazon.ca/*",
